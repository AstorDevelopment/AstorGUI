local function createWindow(theme)
   local RF = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

   local Win = RF:CreateWindow({
      Name = "Astor Hub",
      Icon = "chevrons-left-right",
      LoadingTitle = "AstorGUI",
      LoadingSubtitle = "by Faby",
      Theme = theme,
      DisableRayfieldPrompts = false,
      DisableBuildWarnings = false,
      ConfigurationSaving = {
         Enabled = true,
         FolderName = nil,
         FileName = "Astor Hub"
      },
      Discord = {
         Enabled = false,
         Invite = "noinvitelink",
         RememberJoins = true
      },
      KeySystem = false,
      KeySettings = {
         Title = "Untitled",
         Subtitle = "Key System",
         Note = "No method of obtaining the key is provided",
         FileName = "Key",
         SaveKey = true,
         GrabKeyFromSite = false,
         Key = {"Hello"}
      }
   })

   RF:LoadConfiguration()
   return RF, Win
end

local ThemeList = {"Default", "AmberGlow", "Amethyst", "Bloom", "DarkBlue", "Green", "Light", "Ocean", "Serenity"}

local Rayfield, Window = createWindow("Default")

local function populateUI()
   -- Main Tab
   local MainTab = Window:CreateTab("Admins", 4483362458)
   local MainSection = MainTab:CreateSection("Main Admin UIs")

   MainTab:CreateButton({
      Name = "Activate IY",
      Callback = function()
         loadstring(game:HttpGet("https://raw.githubusercontent.com/AstorDevelopment/AstorGUI/admins/IY"))()
      end
   })


MainTab:CreateButton({
      Name = "Activate VaultScripts",
      Callback = function()
         loadstring(game:HttpGet("https://raw.githubusercontent.com/AstorDevelopment/AstorGUI/admins/VaultScripts"))()
      end
   })


MainTab:CreateButton({
      Name = "Activate CMD-X",
      Callback = function()
         loadstring(game:HttpGet("https://raw.githubusercontent.com/AstorDevelopment/AstorGUI/refs/heads/admins/CMD-X"))()
      end
   })


MainTab:CreateButton({
      Name = "Activate Homebrew",
      Callback = function()
         loadstring(game:HttpGet("https://raw.githubusercontent.com/AstorDevelopment/AstorGUI/refs/heads/admins/Homebrew"))()
      end
   })


MainTab:CreateButton({
      Name = "Activate AstorADM (WIP)",
      Callback = function()
         loadstring(game:HttpGet("https://raw.githubusercontent.com/AstorDevelopment/AstorGUI/refs/heads/admins/AstorADM"))()
      end
   })

   local AnalyzingTab = Window:CreateTab("Analyzing Tools", 4483362458)
   local AnalyzingSection = AnalyzeTab:CreateSection("Tools to analyze games")

    AnalyzingTab:CreateButton({
         Name = "DevEX",
         Callback = function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/AstorDevelopment/AstorGUI/refs/heads/analyzingtools/DevEX"))()
         end
      })


AnalyzingTab:CreateButton({
         Name = "Turtle Remote Spy",
         Callback = function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/AstorDevelopment/AstorGUI/refs/heads/analyzingtools/Turtle%20Remote%20Spy")()
         end
      })


AnalyzingTab:CreateButton({
         Name = "Hydroxide",
         Callback = function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/AstorDevelopment/AstorGUI/refs/heads/analyzingtools/Hydroxide")()
         end
      })


   local ThemeTab = Window:CreateTab("Theme Changer", 4483362458)
   local ThemeSection = ThemeTab:CreateSection("Change Themes")

   for _, themeName in ipairs(ThemeList) do
      ThemeTab:CreateButton({
         Name = themeName,
         Callback = function()
            Rayfield:Destroy()
            wait(0.2)
            Rayfield, Window = createWindow(themeName)
            populateUI() 
         end
      })
   end
end

populateUI()
